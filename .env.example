# PostgreSQL container
POSTGRES_DB=payment_db
POSTGRES_USER=payment_user
POSTGRES_PASSWORD=payment_pass

# PostgreSQL connection (для приложения)
DATABASE_URL=postgresql+asyncpg://payment_user:payment_pass@postgres:5432/payment_db

# RabbitMQ container
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# RabbitMQ connection (для приложения)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# API Key (статический ключ для аутентификации)
API_KEY=test-api-key-change-in-production

# Webhook HMAC secret
WEBHOOK_HMAC_SECRET=webhook-secret-change-in-production

# Webhook timeout (секунды)
WEBHOOK_TIMEOUT=10

# SSRF protection: разрешить приватные адреса для webhook_url (для тестов)
SSRF_ALLOW_PRIVATE=false

# Log level
LOG_LEVEL=INFO